{
  "name": "taio-time-app",
  "version": "0.3.27",
  "private": true,
  "scripts": {
    "build:version": "node scripts/inject-build-version.js",
    "build:css": "node scripts/build-css.js",
    "dev": "npm run build:version && npm run build:css && next dev --webpack -p 3000",
    "build": "npm run build:version && npm run build:css && next build --webpack",
    "start": "node scripts/serve-static.js",
    "deploy:render": "node scripts/trigger-deploy.js",
    "sync:ios": "npm run build && npx cap sync ios",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "i18next": "^27.1.1",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
